<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F6FF">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="88dp" android:fillViewport="true" android:layout_marginTop="60dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="16dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/create_meet_up_label_text" android:textSize="24sp" android:textColor="#252538" android:includeFontPadding="true" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/create_meet_up_label_text_2" android:textSize="14sp" android:textColor="#252538" android:includeFontPadding="true" android:layout_marginTop="8dp" />
                    </LinearLayout>
                    <ImageView android:layout_width="96dp" android:layout_height="112dp" android:src="@drawable/createmeetup_character" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/pickday_card_white" android:orientation="vertical" android:padding="15dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/create_meet_up_label_text_3" android:textColor="#232336" android:textSize="15sp" android:textStyle="bold" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/pickday_unselected">
                    <EditText android:id="@+id/edtMeetupName" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:gravity="center_vertical" android:hint="@string/create_meet_up_edt_meetup_name_hint" android:includeFontPadding="false" android:maxLength="30" android:paddingStart="12dp" android:paddingEnd="48dp" android:singleLine="true" android:textColor="#232336" android:textColorHint="#716C87" android:textSize="14sp" android:textStyle="bold" android:imeOptions="actionNext" />
                    <TextView android:id="@+id/tvNameCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical|end" android:layout_marginEnd="10dp" android:includeFontPadding="false" android:text="@string/create_meet_up_name_count_text" android:textColor="#716C87" android:textSize="12sp" android:textStyle="bold" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/create_meet_up_label_text_4" android:textColor="#232336" android:textSize="15sp" android:textStyle="bold" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginTop="8dp" android:background="@drawable/pickday_unselected">
                    <EditText android:id="@+id/edtMeetupDesc" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:gravity="center_vertical" android:hint="@string/create_meet_up_edt_meetup_desc_hint" android:includeFontPadding="false" android:maxLength="100" android:paddingStart="12dp" android:paddingEnd="52dp" android:singleLine="false" android:textColor="#232336" android:textColorHint="#716C87" android:textSize="14sp" android:textStyle="bold" android:maxLines="3" android:paddingTop="10dp" android:paddingBottom="10dp" />
                    <TextView android:id="@+id/tvDescCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical|end" android:layout_marginEnd="10dp" android:includeFontPadding="false" android:text="@string/create_meet_up_desc_count_text" android:textColor="#716C87" android:textSize="12sp" android:textStyle="bold" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/create_meet_up_label_text_5" android:textColor="#232336" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:includeFontPadding="false" android:text="@string/create_meet_up_label_text_6" android:textColor="#716C87" android:textSize="12sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
                    <FrameLayout android:id="@+id/btnDatePicker" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/pickday_unselected" android:clickable="true" android:focusable="true" android:paddingStart="10dp" android:paddingEnd="8dp">
                        <TextView android:layout_width="16dp" android:layout_height="wrap_content" android:layout_gravity="start|center_vertical" android:gravity="center" android:includeFontPadding="false" android:text="@string/create_meet_up_label_text_7" android:textColor="#6A4DFF" android:textSize="12sp" android:minHeight="16dp" />
                        <TextView android:id="@+id/tvDeadlineDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="23dp" android:includeFontPadding="false" android:maxLines="1" android:text="@string/create_meet_up_deadline_date_text" android:textColor="#232336" android:textSize="16sp" android:textStyle="bold" />
                    </FrameLayout>
                    <FrameLayout android:id="@+id/btnTimePicker" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/pickday_unselected" android:clickable="true" android:focusable="true" android:paddingStart="10dp" android:paddingEnd="8dp" android:layout_marginTop="8dp">
                        <TextView android:id="@+id/tvDeadlineTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginEnd="16dp" android:includeFontPadding="false" android:maxLines="1" android:text="@string/create_meet_up_deadline_time_text" android:textColor="#232336" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:includeFontPadding="false" android:text="@string/create_meet_up_label_text_8" android:textColor="#232336" android:textSize="12sp" />
                    </FrameLayout>
                </LinearLayout>
                <include android:id="@+id/deadlineCalendar" layout="@layout/view_pickday_calendar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/create_meet_up_label_text_9" android:textColor="#232336" android:textSize="15sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/pickday_unselected" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
                    <TextView android:id="@+id/btnMinusPeople" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/pickday_card_soft" android:clickable="true" android:focusable="true" android:gravity="center" android:includeFontPadding="false" android:text="@string/create_meet_up_minus_people_text" android:textColor="#6A4DFF" android:textSize="14sp" android:textStyle="bold" android:minHeight="48dp" />
                    <TextView android:id="@+id/tvPeopleCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:includeFontPadding="false" android:text="@string/create_meet_up_people_count_text" android:textColor="#716C87" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/btnPlusPeople" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/pickday_card_soft" android:clickable="true" android:focusable="true" android:gravity="center" android:includeFontPadding="false" android:text="@string/calendar_fab_text" android:textColor="#6A4DFF" android:textSize="14sp" android:textStyle="bold" android:minHeight="48dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <TextView android:id="@+id/btnNext" android:layout_width="match_parent" android:layout_height="54dp" android:layout_gravity="bottom" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="16dp" android:background="@drawable/pickday_button_primary" android:clickable="true" android:focusable="true" android:gravity="center" android:includeFontPadding="false" android:text="@string/create_meet_up_next_text" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:minHeight="48dp" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/all_meetup_rooms_back_text" android:background="@drawable/pickday_card_white" android:textColor="#252538" android:textSize="22sp" android:padding="0dp" android:minWidth="0dp" android:minHeight="48dp" android:contentDescription="@string/action_back" android:layout_gravity="top|start" android:layout_marginStart="16dp" android:layout_marginTop="12dp" />
</FrameLayout>
