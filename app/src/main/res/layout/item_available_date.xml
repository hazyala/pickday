<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dateRoot"
    android:layout_width="62dp"
    android:layout_height="86dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_home_date_card">

    <TextView
        android:id="@+id/tvDateBest"
        android:layout_width="42dp"
        android:layout_height="18dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_home_best_badge"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="BEST"
        android:textColor="@color/pickday_text_white"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="11dp"
        android:paddingEnd="6dp"
        android:paddingBottom="9dp">

        <TextView
            android:id="@+id/tvDateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="오늘"
            android:textColor="@color/pickday_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:includeFontPadding="false"
            android:text="5.21"
            android:textColor="@color/pickday_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDayOfWeek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:includeFontPadding="false"
            android:text="(수)"
            android:textColor="@color/pickday_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAvailableCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:text="3명"
            android:textColor="@color/pickday_purple"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
