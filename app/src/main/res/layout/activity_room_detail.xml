<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8F7FF">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="96dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="30dp" android:paddingEnd="20dp" android:paddingBottom="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/pickday_card_white" app:backgroundTint="@null" android:gravity="center" android:padding="0dp" android:minWidth="0dp" android:minHeight="48dp" android:text="@string/all_meetup_rooms_back_text" android:textAllCaps="false" android:textColor="#202033" android:textSize="24sp" android:includeFontPadding="false" android:textStyle="bold" android:contentDescription="@string/action_back" />
                        <TextView android:id="@+id/tvRoomStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/pickday_card_glass" android:gravity="center" android:includeFontPadding="false" android:text="@string/room_detail_room_status_text" android:textColor="#6A4DFF" android:textSize="13sp" android:textStyle="bold" android:minHeight="28dp" android:padding="8dp" />
                    </LinearLayout>
                    <ImageView android:id="@+id/imgRoomCharacter" android:layout_width="104dp" android:layout_height="112dp" android:layout_gravity="top|end" android:src="@drawable/roomdeatil_charactor" android:scaleType="fitCenter" />
                </LinearLayout>
                <TextView android:id="@+id/tvRoomTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/invite_members_invite_room_title_text" android:textColor="#202033" android:textSize="25sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextView android:id="@+id/tvRoomSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/room_detail_room_subtitle_text" android:textColor="#716C87" android:textSize="15sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextView android:id="@+id/tvDeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/invite_members_invite_deadline_text" android:textColor="#5B4CDB" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/tvParticipantSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/invite_members_invite_participants_text" android:textColor="#5B4CDB" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="8dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/pickday_card_white" android:orientation="vertical" android:padding="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/room_detail_label_text" android:layout_marginLeft="10dp" android:includeFontPadding="false" android:textColor="#5B4CDB" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvProgressUpdatedAt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/invite_members_invite_room_title_text" android:includeFontPadding="false" android:textColor="#716C87" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:minHeight="60dp">
                    <TextView android:id="@+id/tvParticipantProgress" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/room_detail_participant_progress_text" android:textColor="#202033" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvResponseCompleted" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/room_detail_response_completed_text" android:textColor="#202033" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvResponseWaiting" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/room_detail_response_waiting_text" android:textColor="#202033" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvConfirmedSchedule" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/room_detail_confirmed_schedule_text" android:textColor="#202033" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/btnConfirmSchedule" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/pickday_button_primary" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/room_detail_confirm_schedule_text" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:minHeight="48dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="27dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/pickday_card_soft" android:orientation="horizontal" android:minHeight="8dp">
                        <View android:id="@+id/viewProgressComplete" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/pickday_button_primary" />
                        <View android:id="@+id/viewProgressWaiting" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvProgressRate" android:layout_width="44dp" android:layout_height="wrap_content" android:gravity="end" android:text="@string/invite_members_invite_room_title_text" android:textColor="#202033" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/pickday_card_white" android:orientation="vertical" android:padding="10dp" android:minHeight="130dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/room_detail_label_text_2" android:textColor="#5B4CDB" android:includeFontPadding="false" android:textSize="15sp" android:textStyle="bold" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:scrollbars="none" android:minHeight="104dp">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="10dp" android:orientation="horizontal">
                        <TextView android:id="@+id/tvCandidateDate1" android:layout_width="100dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:background="@drawable/pickday_selected" android:gravity="center" android:text="@string/invite_members_invite_room_title_text" android:textColor="#5B4CDB" android:textSize="12sp" android:textStyle="bold" android:minHeight="88dp" android:padding="8dp" />
                        <TextView android:id="@+id/tvCandidateDate2" android:layout_width="100dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:background="@drawable/pickday_unselected" android:gravity="center" android:text="@string/invite_members_invite_room_title_text" android:textColor="#77748E" android:textSize="12sp" android:textStyle="bold" android:minHeight="88dp" android:padding="8dp" />
                        <TextView android:id="@+id/tvCandidateDate3" android:layout_width="100dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:background="@drawable/pickday_unselected" android:gravity="center" android:text="@string/invite_members_invite_room_title_text" android:textColor="#77748E" android:textSize="12sp" android:textStyle="bold" android:minHeight="88dp" android:padding="8dp" />
                        <TextView android:id="@+id/tvCandidateDate4" android:layout_width="100dp" android:layout_height="wrap_content" android:background="@drawable/pickday_unselected" android:gravity="center" android:text="@string/invite_members_invite_room_title_text" android:textColor="#77748E" android:textSize="12sp" android:textStyle="bold" android:minHeight="88dp" android:padding="8dp" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/pickday_card_white" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:minHeight="150dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/room_detail_label_text_3" android:includeFontPadding="false" android:textColor="#5B4CDB" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" />
                <TextView android:id="@+id/tvTimePreference1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/invite_members_invite_room_title_text" android:textColor="#77748E" android:textSize="12sp" android:includeFontPadding="false" android:textStyle="bold" />
                <TextView android:id="@+id/tvTimePreference2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/invite_members_invite_room_title_text" android:textColor="#77748E" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvTimePreference3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/invite_members_invite_room_title_text" android:textColor="#77748E" android:includeFontPadding="false" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvTimePreference4" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/invite_members_invite_room_title_text" android:textColor="#77748E" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvTimePreference5" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/invite_members_invite_room_title_text" android:textColor="#C9C6D8" android:includeFontPadding="false" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/pickday_card_white" android:orientation="vertical" android:padding="10dp" android:minHeight="140dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/tvParticipantSectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/room_detail_participant_section_title_text" android:textColor="#5B4CDB" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/btnViewAllParticipants" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:text="@string/home_view_all_dates_text" android:textColor="#6A4DFF" android:textSize="12sp" android:textStyle="bold" android:minHeight="48dp" />
                </LinearLayout>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:minHeight="94dp">
                    <LinearLayout android:id="@+id/layoutParticipantContainer" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <TextView android:id="@+id/btnChangeResponse" android:layout_width="match_parent" android:layout_height="62dp" android:layout_gravity="bottom" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginBottom="16dp" android:background="@drawable/pickday_button_primary" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/room_detail_change_response_text" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:minHeight="48dp" />
</FrameLayout>
