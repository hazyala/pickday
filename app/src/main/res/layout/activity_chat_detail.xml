<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8F7FF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="22dp" android:paddingTop="28dp" android:paddingEnd="22dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="52dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <ImageView android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:padding="8dp" android:scaleType="centerInside" android:src="@drawable/ic_arrow_back" app:tint="#252538" android:contentDescription="@string/action_back" />
            <TextView android:id="@+id/tvChatDetailTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:text="@string/chat_detail_chat_detail_title_text" android:textColor="#202033" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_chat_notice" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:minHeight="86dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_chat_notice_icon" android:padding="9dp" android:scaleType="centerInside" android:src="@drawable/icon_annotation" app:tint="#5B4CDB" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvChatNoticeTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/chat_detail_chat_notice_title_text" android:textColor="#252538" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvChatNoticeMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:includeFontPadding="false" android:text="@string/chat_detail_chat_notice_meta_text" android:textColor="#77748E" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
        <ScrollView android:id="@+id/scrollChatMessages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="18dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="16dp">
            <LinearLayout android:id="@+id/layoutChatMessageContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/tvChatEmptyState" android:layout_width="match_parent" android:layout_height="220dp" android:gravity="center" android:includeFontPadding="false" android:text="@string/chat_detail_chat_empty_state_text" android:textColor="#716C87" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/pickday_input_field" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="8dp" android:minHeight="54dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <EditText android:id="@+id/etMessageInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@android:color/transparent" android:hint="@string/chat_detail_et_message_input_hint" android:includeFontPadding="false" android:inputType="textMultiLine|textCapSentences" android:maxLines="3" android:minHeight="0dp" android:padding="0dp" android:textColor="#252538" android:textColorHint="#B7B8CC" android:textSize="14sp" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnSendMessage" android:layout_width="62dp" android:layout_height="48dp" android:background="@drawable/pickday_button_primary" android:gravity="center" android:includeFontPadding="false" android:text="@string/chat_detail_send_message_text" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:minHeight="48dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
