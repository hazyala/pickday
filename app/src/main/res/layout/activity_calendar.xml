<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FAF9FF">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="36dp" android:paddingBottom="92dp" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:includeFontPadding="false" android:text="@string/calendar_label_text" android:textColor="#20213B" android:textSize="30sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@drawable/pickday_card_white" android:orientation="vertical" android:padding="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/btnPrevMonth" android:layout_width="42dp" android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false" android:text="@string/calendar_prev_month_text" android:textColor="#20213B" android:textSize="30sp" android:textStyle="bold" android:minHeight="48dp" />
                    <TextView android:id="@+id/tvMonthTitle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:includeFontPadding="false" android:text="@string/calendar_month_title_text" android:textColor="#20213B" android:textSize="22sp" android:textStyle="bold" />
                    <TextView android:id="@+id/btnNextMonth" android:layout_width="42dp" android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false" android:text="@string/calendar_next_month_text" android:textColor="#20213B" android:textSize="30sp" android:textStyle="bold" android:minHeight="48dp" />
                </LinearLayout>
                <GridLayout android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="18dp" android:columnCount="7">
                    <TextView style="@style/PickDayCalendarWeekText" android:text="@string/room_badge_default" android:textColor="#FF4F91" />
                    <TextView style="@style/PickDayCalendarWeekText" android:text="@string/calendar_label_text_2" />
                    <TextView style="@style/PickDayCalendarWeekText" android:text="@string/calendar_label_text_3" />
                    <TextView style="@style/PickDayCalendarWeekText" android:text="@string/calendar_label_text_4" />
                    <TextView style="@style/PickDayCalendarWeekText" android:text="@string/calendar_label_text_5" />
                    <TextView style="@style/PickDayCalendarWeekText" android:text="@string/calendar_label_text_6" />
                    <TextView style="@style/PickDayCalendarWeekText" android:text="@string/calendar_label_text_7" android:textColor="#5B2DFF" />
                </GridLayout>
                <GridLayout android:id="@+id/monthGrid" android:layout_width="match_parent" android:layout_height="270dp" android:layout_marginTop="8dp" android:columnCount="7" android:rowCount="6" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="8dp" android:background="@drawable/pickday_unselected" android:gravity="center" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/calendar_label_text_8" android:textColor="#FF9338" android:textSize="12sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="22dp" android:text="@string/calendar_label_text_9" android:textColor="#4EBD73" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="20dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/tvScheduleTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/calendar_schedule_title_text" android:textColor="#20213B" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/calendar_order_label" android:textColor="#20213B" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/layoutScheduleContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:layout_gravity="bottom" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_bottom_nav" android:gravity="center" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
        <LinearLayout android:id="@+id/tabHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:scaleType="centerInside" android:src="@drawable/icon_home" app:tint="#716C87" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:text="@string/calendar_label_text_11" android:textColor="#716C87" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tabCalendar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:scaleType="centerInside" android:src="@drawable/icon_calendars" app:tint="#5B2DFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:text="@string/calendar_label_text" android:textColor="#5B2DFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnFab" android:layout_width="53dp" android:layout_height="53dp" android:background="@drawable/bg_fab_circle" android:gravity="center" android:includeFontPadding="false" android:minWidth="0dp" android:minHeight="48dp" android:padding="0dp" android:text="@string/calendar_fab_text" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="38sp" />
        <LinearLayout android:id="@+id/tabChat" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:scaleType="centerInside" android:src="@drawable/icon_message" app:tint="#716C87" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:text="@string/calendar_label_text_12" android:textColor="#716C87" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tabMy" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:scaleType="centerInside" android:src="@drawable/icon_person" app:tint="#716C87" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:text="@string/calendar_label_text_13" android:textColor="#716C87" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
