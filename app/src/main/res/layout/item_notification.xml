<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:background="@drawable/pickday_card_white" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingTop="16dp" android:paddingEnd="18dp" android:paddingBottom="16dp">
    <TextView android:id="@+id/tvNotificationDot" android:layout_width="14dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/notification_notification_dot_text" android:textColor="#5B4CDB" android:textSize="14sp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvNotificationTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:text="@string/notification_notification_title_text" android:textColor="#202033" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvNotificationRoom" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:text="@string/notification_notification_room_text" android:textColor="#77748E" android:textSize="14sp" />
        <TextView android:id="@+id/tvNotificationMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:text="@string/notification_notification_message_text" android:textColor="#77748E" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/tvNotificationTime" android:layout_width="54dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:gravity="end" android:includeFontPadding="false" android:text="@string/notification_notification_time_text" android:textColor="#77748E" android:textSize="13sp" />
</LinearLayout>
