<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8F7FF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="30dp" android:paddingEnd="16dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/pickday_card_white" app:backgroundTint="@null" android:gravity="center" android:text="@string/all_meetup_rooms_back_text" android:textColor="#252538" android:textSize="22sp" android:textStyle="bold" android:textAllCaps="false" android:includeFontPadding="false" android:minWidth="0dp" android:minHeight="48dp" android:padding="0dp" android:contentDescription="@string/action_back" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/response_selection_label_text" android:textColor="#232336" android:textSize="22sp" android:textStyle="bold" android:includeFontPadding="false" android:layout_weight="1" android:layout_marginStart="12dp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/response_selection_label_text_2" android:textColor="#716C87" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" />
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="ifContentScrolls">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/pickday_card_white" android:orientation="vertical" android:padding="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end|center_vertical" android:orientation="horizontal" android:minHeight="22dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/response_selection_label_text_3" android:textColor="#5B4CDB" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/response_selection_label_text_4" android:textColor="#B7A5FF" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/response_selection_label_text_5" android:textColor="#716C87" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <include android:id="@+id/responseCalendar" layout="@layout/view_pickday_calendar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                <TextView android:id="@+id/tvDateCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/pickday_card_soft" android:gravity="center_vertical" android:paddingStart="10dp" android:includeFontPadding="false" android:text="@string/response_selection_date_count_text" android:textColor="#716C87" android:textSize="12sp" android:textStyle="bold" android:minHeight="30dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="26dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/response_selection_label_text_6" android:layout_marginLeft="10dp" android:textColor="#232336" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="10dp" android:minHeight="30dp" />
                    <TextView android:id="@+id/tvSelectedDateCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/response_selection_selected_date_count_text" android:textColor="#6A4DFF" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:padding="10dp" android:overScrollMode="never" android:minHeight="72dp">
                    <LinearLayout android:id="@+id/layoutSelectedDates" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" />
                </HorizontalScrollView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="10dp" android:layout_marginTop="5dp" android:text="@string/response_selection_label_text_7" android:textColor="#232336" android:textSize="14sp" android:textStyle="bold" android:minHeight="30dp" />
                <LinearLayout android:id="@+id/layoutTimeOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
                    <TextView android:id="@+id/timeMorning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:layout_marginBottom="7dp" android:background="@drawable/pickday_unselected" android:gravity="center" android:text="@string/response_selection_time_morning_text" android:textColor="#59566F" android:textSize="12sp" android:textStyle="bold" android:minHeight="56dp" android:padding="12dp" />
                    <TextView android:id="@+id/timeAfternoon" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:layout_marginBottom="7dp" android:background="@drawable/pickday_unselected" android:gravity="center" android:text="@string/response_selection_time_afternoon_text" android:textColor="#59566F" android:textSize="12sp" android:textStyle="bold" android:minHeight="56dp" android:padding="12dp" />
                    <TextView android:id="@+id/timeLateAfternoon" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="7dp" android:background="@drawable/pickday_unselected" android:gravity="center" android:text="@string/response_selection_time_late_afternoon_text" android:textColor="#59566F" android:textSize="12sp" android:textStyle="bold" android:minHeight="56dp" android:padding="12dp" />
                    <TextView android:id="@+id/timeEvening" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:background="@drawable/pickday_unselected" android:gravity="center" android:text="@string/response_selection_time_evening_text" android:textColor="#59566F" android:textSize="12sp" android:textStyle="bold" android:minHeight="56dp" android:padding="12dp" />
                    <TextView android:id="@+id/timeLateEvening" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:background="@drawable/pickday_unselected" android:gravity="center" android:text="@string/response_selection_time_late_evening_text" android:textColor="#59566F" android:textSize="12sp" android:textStyle="bold" android:minHeight="56dp" android:padding="12dp" />
                    <TextView android:id="@+id/timeAny" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/pickday_unselected" android:gravity="center" android:text="@string/response_selection_time_any_text" android:textColor="#59566F" android:textSize="12sp" android:textStyle="bold" android:minHeight="56dp" android:padding="12dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="@drawable/pickday_card_soft" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="15dp" android:paddingEnd="15dp" android:minHeight="50dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/response_selection_label_text_8" android:textColor="#6A4DFF" android:textSize="12sp" android:textStyle="bold" />
                    <ImageView android:layout_width="42dp" android:layout_height="42dp" android:padding="9dp" android:src="@drawable/icon_calendars" app:tint="#6A4DFF" android:scaleType="centerInside" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="24dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/response_selection_label_text_9" android:layout_marginLeft="10dp" android:textColor="#232336" android:textSize="13sp" android:textStyle="bold" android:minHeight="30dp" />
                    <TextView android:id="@+id/tvExcludeCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/response_selection_exclude_count_text" android:textColor="#6A4DFF" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:scrollbars="none" android:overScrollMode="never" android:minHeight="72dp">
                    <LinearLayout android:id="@+id/layoutExcludeDates" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal">
                        <TextView android:id="@+id/exclude0529" style="@style/PickDayExcludeDateChip" android:text="@string/invite_members_invite_room_title_text" />
                        <TextView android:id="@+id/exclude0530" style="@style/PickDayExcludeDateChip" android:text="@string/invite_members_invite_room_title_text" />
                        <TextView android:id="@+id/exclude0531" style="@style/PickDayExcludeDateChip" android:text="@string/invite_members_invite_room_title_text" />
                        <TextView android:id="@+id/exclude0601" style="@style/PickDayExcludeDateChip" android:text="@string/invite_members_invite_room_title_text" />
                        <TextView android:id="@+id/exclude0602" style="@style/PickDayExcludeDateChip" android:text="@string/invite_members_invite_room_title_text" />
                        <TextView android:id="@+id/exclude0603" style="@style/PickDayExcludeDateChip" android:text="@string/invite_members_invite_room_title_text" />
                        <TextView android:id="@+id/exclude0604" style="@style/PickDayExcludeDateChip" android:text="@string/invite_members_invite_room_title_text" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </ScrollView>
        <TextView android:id="@+id/btnComplete" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/pickday_button_primary" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/response_selection_complete_text" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false" android:minHeight="48dp" />
    </LinearLayout>
</FrameLayout>
