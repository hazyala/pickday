<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/messageRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp" android:gravity="start" android:orientation="vertical">
    <TextView android:id="@+id/tvSenderName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="54dp" android:layout_marginEnd="54dp" android:includeFontPadding="false" android:text="@string/chat_message_sender_name_text" android:textColor="#252538" android:textSize="12sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/layoutMessageRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="start" android:orientation="horizontal">
        <TextView android:id="@+id/tvLeftAvatar" android:layout_width="42dp" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:background="@drawable/bg_chat_avatar" android:gravity="center" android:includeFontPadding="false" android:text="@string/chat_message_left_avatar_text" android:textColor="#5B4CDB" android:textSize="15sp" android:textStyle="bold" android:minHeight="42dp" />
        <TextView android:id="@+id/tvBubble" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="250dp" android:background="@drawable/bg_chat_bubble_other" android:includeFontPadding="false" android:lineSpacingExtra="4dp" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp" android:text="@string/chat_message_bubble_text" android:textColor="#252538" android:textSize="15sp" />
        <TextView android:id="@+id/tvRightAvatar" android:layout_width="42dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/bg_chat_avatar" android:gravity="center" android:includeFontPadding="false" android:text="@string/chat_message_left_avatar_text" android:textColor="#5B4CDB" android:textSize="15sp" android:textStyle="bold" android:visibility="gone" android:minHeight="42dp" />
    </LinearLayout>
    <TextView android:id="@+id/tvMessageTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="54dp" android:layout_marginTop="6dp" android:layout_marginEnd="54dp" android:includeFontPadding="false" android:text="@string/chat_message_message_time_text" android:textColor="#716C87" android:textSize="12sp" />
</LinearLayout>
