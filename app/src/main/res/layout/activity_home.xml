<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pickday_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="28dp"
            android:paddingEnd="22dp"
            android:paddingBottom="104dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_home_profile"
                    android:padding="3dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/home_profile" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="안녕하세요, 김해민님"
                        android:textColor="@color/pickday_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvHomeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="오늘도 픽데이로\n쉽게 약속 잡아봐요"
                        android:textColor="@color/pickday_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnNotification"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_home_icon_button"
                    android:clickable="true"
                    android:contentDescription="알림"
                    android:focusable="true"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_notification" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardMainMeetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_home_main_card"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMainStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="진행 중인 약속"
                        android:textColor="@color/pickday_purple_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMainResponseRate"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_home_rate_badge"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="1dp"
                        android:text="78%\n응답 완료"
                        android:textColor="@color/pickday_purple"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMainTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="동아리 MT 일정 정하기"
                    android:textColor="@color/pickday_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMainParticipants"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_home_chip"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="참여자 7명"
                        android:textColor="@color/pickday_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMainDday"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_home_chip"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="마감까지 D-2"
                        android:textColor="@color/pickday_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="142dp"
                    android:layout_marginTop="18dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="116dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_home_inner_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="112dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_home_best_pill"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="1순위 날짜"
                                android:textColor="@color/pickday_purple"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBestDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:maxLines="2"
                                android:text="5월 25일 (일) 오후 2시"
                                android:textColor="@color/pickday_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBestCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:includeFontPadding="false"
                                android:text="5명 가능"
                                android:textColor="@color/pickday_purple"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgHomeCharacter"
                        android:layout_width="170dp"
                        android:layout_height="150dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="34dp"
                        android:layout_marginBottom="-4dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:scaleX="1.55"
                        android:scaleY="1.55"
                        android:src="@drawable/splash_character" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDetail"
                        android:layout_width="92dp"
                        android:layout_height="44dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginBottom="18dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_home_secondary_button"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="상세 보기"
                        android:textAllCaps="false"
                        android:textColor="@color/pickday_purple"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/cardEmptyMeetup"
                android:layout_width="match_parent"
                android:layout_height="122dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_home_main_card"
                android:paddingStart="22dp"
                android:paddingEnd="18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingEnd="120dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="아직 진행 중인 약속이 없어요"
                        android:textColor="@color/pickday_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="첫 약속 방을 만들면 가능한 날짜와 응답률이 이곳에 표시됩니다."
                        android:textColor="@color/pickday_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="86dp"
                    android:layout_gravity="end|center_vertical"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/home_character" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/sectionAvailableDates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="이번 주 가능한 날"
                        android:textColor="@color/pickday_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="전체 보기"
                        android:textColor="@color/pickday_purple"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutDateContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="7명 이상"
                        android:textColor="@color/pickday_purple"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:includeFontPadding="false"
                        android:text="4~6명"
                        android:textColor="#5F9DFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:includeFontPadding="false"
                        android:text="1~3명"
                        android:textColor="#9D97C8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:includeFontPadding="false"
                        android:text="0명"
                        android:textColor="#C9C7D8"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="내 약속 방"
                    android:textColor="@color/pickday_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="전체 보기"
                    android:textColor="@color/pickday_purple"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRoomContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvRoomEmpty"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_home_inner_card"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="아직 만든 약속 방이 없어요.\n새 약속 방을 만들면 여기에 표시됩니다."
                android:textColor="@color/pickday_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/cardCreateMeetup"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_home_create_card"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="94dp"
                    android:layout_height="94dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="-14dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:scaleX="1.85"
                    android:scaleY="1.85"
                    android:src="@drawable/home_character" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="새로운 약속 방을 만들어보세요"
                        android:textColor="@color/pickday_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="여러 사람의 일정을 한 번에 픽!"
                        android:textColor="@color/pickday_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCreateSmall"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_fab_circle"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textAllCaps="false"
                    android:textColor="@color/pickday_text_white"
                    android:textSize="26sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="홈"
            android:textColor="@color/pickday_purple"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="캘린더"
            android:textColor="@color/pickday_text_secondary"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFab"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_fab_circle"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+"
            android:textAllCaps="false"
            android:textColor="@color/pickday_text_white"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tabAlarm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="알림"
            android:textColor="@color/pickday_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tabMy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="내 정보"
            android:textColor="@color/pickday_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>
