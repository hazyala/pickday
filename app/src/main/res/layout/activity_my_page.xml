<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8F7FF">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:paddingBottom="84dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingTop="36dp" android:paddingEnd="22dp" android:paddingBottom="98dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="52dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:includeFontPadding="false" android:text="@string/calendar_label_text_13" android:textColor="#202033" android:textSize="28sp" android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnSettings" android:layout_width="54dp" android:layout_height="48dp" android:background="@drawable/pickday_card_white" app:backgroundTint="@null" android:gravity="center" android:includeFontPadding="false" android:minWidth="0dp" android:minHeight="48dp" android:padding="0dp" android:text="@string/my_page_settings_text" android:textAllCaps="false" android:textColor="#202033" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/pickday_card_white" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="88dp" android:layout_height="104dp" android:src="@drawable/home_profile" android:scaleType="centerCrop" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:orientation="vertical" android:layout_weight="1">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/pickday_card_glass" android:gravity="center" android:includeFontPadding="false" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/my_page_label_text" android:textColor="#6A4DFF" android:textSize="12sp" android:textStyle="bold" android:minHeight="24dp" />
                        <TextView android:id="@+id/tvUserName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:includeFontPadding="false" android:text="@string/my_page_user_name_text" android:textColor="#202033" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvUserSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:includeFontPadding="false" android:text="@string/my_page_user_summary_text" android:textColor="#77748E" android:textSize="12sp" />
                        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnProfileEdit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/pickday_card_glass" app:backgroundTint="@null" android:gravity="center" android:includeFontPadding="false" android:minWidth="0dp" android:minHeight="48dp" android:padding="12dp" android:text="@string/my_page_profile_edit_text" android:textAllCaps="false" android:textColor="#5B4CDB" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/pickday_card_glass" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp" android:columnCount="2" android:rowCount="2">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:layout_columnWeight="1" android:layout_column="0" android:layout_row="0" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:text="@string/chat_active_room_tab_text" android:textColor="#6F6D88" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:includeFontPadding="false" android:text="@string/my_page_label_text_2" android:textColor="#5B4CDB" android:textSize="22sp" android:textStyle="bold" android:id="@+id/tvActiveRoomsCount" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:includeFontPadding="false" android:text="@string/home_main_status_text" android:textColor="#716C87" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:layout_columnWeight="1" android:layout_column="1" android:layout_row="0" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:text="@string/response_completed" android:textColor="#6F6D88" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:includeFontPadding="false" android:text="@string/my_page_label_text_3" android:textColor="#5B4CDB" android:textSize="22sp" android:textStyle="bold" android:id="@+id/tvSubmittedRoomsCount" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:includeFontPadding="false" android:text="@string/my_page_label_text_4" android:textColor="#716C87" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:layout_columnWeight="1" android:layout_column="0" android:layout_row="1" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:text="@string/my_page_label_text_5" android:textColor="#6F6D88" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:includeFontPadding="false" android:text="@string/my_page_label_text_6" android:textColor="#5B4CDB" android:textSize="22sp" android:textStyle="bold" android:id="@+id/tvConfirmedRoomsCount" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:includeFontPadding="false" android:text="@string/my_page_label_text_7" android:textColor="#716C87" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:layout_columnWeight="1" android:layout_column="1" android:layout_row="1" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:text="@string/total_rooms_title" android:textColor="#6F6D88" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:includeFontPadding="false" android:text="@string/my_page_label_text_9" android:textColor="#5B4CDB" android:textSize="22sp" android:textStyle="bold" android:id="@+id/tvTotalRoomsCount" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:includeFontPadding="false" android:text="@string/total_rooms_subtitle" android:textColor="#716C87" android:textSize="12sp" />
                    </LinearLayout>
                </GridLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/pickday_card_white" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="18dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/my_page_label_text_11" android:textColor="#202033" android:textSize="15sp" android:textStyle="bold" />
                <include layout="@layout/item_my_page_row" android:id="@+id/rowCreatedRooms" />
                <include layout="@layout/item_my_page_row" android:id="@+id/rowJoinedRooms" />
                <include layout="@layout/item_my_page_row" android:id="@+id/rowConfirmedSchedules" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/pickday_card_white" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="18dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/my_page_label_text_12" android:textColor="#202033" android:textSize="15sp" android:textStyle="bold" />
                <include layout="@layout/item_my_page_row" android:id="@+id/rowNotificationSettings" />
                <include layout="@layout/item_my_page_row" android:id="@+id/rowThemeSettings" />
                <include layout="@layout/item_my_page_row" android:id="@+id/rowServiceInfo" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/pickday_card_white" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="18dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/my_page_label_text_13" android:textColor="#202033" android:textSize="15sp" android:textStyle="bold" />
                <include layout="@layout/item_my_page_row" android:id="@+id/rowLogout" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:includeFontPadding="false" android:text="@string/my_page_label_text_14" android:textColor="#716C87" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:layout_gravity="bottom" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_bottom_nav" android:gravity="center" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
        <LinearLayout android:id="@+id/tabHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/icon_home" app:tint="#716C87" android:scaleType="centerInside" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:text="@string/calendar_label_text_11" android:textColor="#716C87" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tabCalendar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/icon_calendars" app:tint="#716C87" android:scaleType="centerInside" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:text="@string/calendar_label_text" android:textColor="#716C87" android:textSize="12sp" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnFab" android:layout_width="53dp" android:layout_height="53dp" android:background="@drawable/bg_fab_circle" android:gravity="center" android:includeFontPadding="false" android:minWidth="0dp" android:minHeight="48dp" android:padding="0dp" android:text="@string/calendar_fab_text" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="38sp" />
        <LinearLayout android:id="@+id/tabChat" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/icon_message" app:tint="#716C87" android:scaleType="centerInside" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:text="@string/calendar_label_text_12" android:textColor="#716C87" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tabMy" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/icon_person" app:tint="#5B4CDB" android:scaleType="centerInside" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:text="@string/calendar_label_text_13" android:textColor="#5B4CDB" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
