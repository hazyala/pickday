<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F6FF">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="74dp" android:fillViewport="true" android:overScrollMode="never" android:layout_marginTop="60dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="16dp" android:paddingEnd="16dp" android:paddingBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/selection_label_text_2" android:textSize="24sp" android:textColor="#252538" android:includeFontPadding="true" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/selection_label_text_3" android:textSize="14sp" android:textColor="#252538" android:includeFontPadding="true" android:layout_marginTop="8dp" />
                    </LinearLayout>
                    <ImageView android:layout_width="96dp" android:layout_height="112dp" android:src="@drawable/selection_charactor" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/pickday_card_white" android:orientation="vertical" android:padding="15dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/selection_label_text_5" android:textColor="#232336" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:overScrollMode="never" android:scrollbars="none" android:minHeight="72dp">
                    <LinearLayout android:id="@+id/layoutCandidateDates" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" />
                </HorizontalScrollView>
                <include android:id="@+id/selectionCalendar" layout="@layout/view_pickday_calendar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
                <TextView android:id="@+id/tvDateCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/selection_date_count_text" android:textColor="#9A96B4" android:textSize="12sp" android:textStyle="bold" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="18dp" android:background="#EEEAFB" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/selection_label_text_6" android:textColor="#232336" android:textSize="15sp" android:textStyle="bold" />
                <GridLayout android:id="@+id/layoutTimeOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:columnCount="2">
                    <TextView android:id="@+id/timeMorning" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginEnd="7dp" android:layout_marginBottom="8dp" android:background="@drawable/pickday_unselected" android:gravity="center" android:text="@string/selection_time_morning_text" android:textColor="#59566F" android:textSize="14sp" android:textStyle="bold" android:minHeight="64dp" android:layout_gravity="fill" android:padding="8dp" />
                    <TextView android:id="@+id/timeAfternoon" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginStart="7dp" android:layout_marginBottom="8dp" android:background="@drawable/pickday_unselected" android:gravity="center" android:text="@string/selection_time_afternoon_text" android:textColor="#59566F" android:textSize="14sp" android:textStyle="bold" android:minHeight="64dp" android:layout_gravity="fill" android:padding="8dp" />
                    <TextView android:id="@+id/timeLateAfternoon" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginEnd="7dp" android:layout_marginBottom="8dp" android:background="@drawable/pickday_unselected" android:gravity="center" android:text="@string/selection_time_late_afternoon_text" android:textColor="#59566F" android:textSize="14sp" android:textStyle="bold" android:minHeight="64dp" android:layout_gravity="fill" android:padding="8dp" />
                    <TextView android:id="@+id/timeEvening" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginStart="7dp" android:layout_marginBottom="8dp" android:background="@drawable/pickday_unselected" android:gravity="center" android:text="@string/selection_time_evening_text" android:textColor="#59566F" android:textSize="14sp" android:textStyle="bold" android:minHeight="64dp" android:layout_gravity="fill" android:padding="8dp" />
                    <TextView android:id="@+id/timeLateEvening" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginEnd="7dp" android:background="@drawable/pickday_unselected" android:gravity="center" android:text="@string/selection_time_late_evening_text" android:textColor="#59566F" android:textSize="14sp" android:textStyle="bold" android:minHeight="64dp" android:layout_gravity="fill" android:padding="8dp" />
                    <TextView android:id="@+id/timeAny" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginStart="7dp" android:background="@drawable/pickday_unselected" android:gravity="center" android:text="@string/selection_time_any_text" android:textColor="#59566F" android:textSize="14sp" android:textStyle="bold" android:minHeight="64dp" android:layout_gravity="fill" android:padding="8dp" />
                </GridLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/pickday_card_soft" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:minHeight="70dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/selection_label_text_7" android:textColor="#6A4DFF" android:textSize="12sp" android:textStyle="bold" />
                    <ImageView android:layout_width="54dp" android:layout_height="54dp" android:padding="12dp" android:src="@drawable/icon_calendars" app:tint="#6A4DFF" android:scaleType="centerInside" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="18dp" android:background="#EEEAFB" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="36dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/selection_label_text_8" android:textColor="#232336" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvExcludeCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/selection_exclude_count_text" android:textColor="#6A4DFF" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/selection_label_text_9" android:textColor="#716C87" android:textSize="12sp" android:textStyle="bold" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:overScrollMode="never" android:scrollbars="none" android:minHeight="72dp">
                    <LinearLayout android:id="@+id/layoutExcludeDates" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal">
                        <TextView android:id="@+id/exclude0529" style="@style/PickDayExcludeDateChip" android:text="@string/invite_members_invite_room_title_text" />
                        <TextView android:id="@+id/exclude0530" style="@style/PickDayExcludeDateChip" android:text="@string/invite_members_invite_room_title_text" />
                        <TextView android:id="@+id/exclude0531" style="@style/PickDayExcludeDateChip" android:text="@string/invite_members_invite_room_title_text" />
                        <TextView android:id="@+id/exclude0601" style="@style/PickDayExcludeDateChip" android:text="@string/invite_members_invite_room_title_text" />
                        <TextView android:id="@+id/exclude0605" style="@style/PickDayExcludeDateChip" android:text="@string/invite_members_invite_room_title_text" />
                        <TextView android:id="@+id/exclude0606" style="@style/PickDayExcludeDateChip" android:text="@string/invite_members_invite_room_title_text" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <TextView android:id="@+id/btnNext" android:layout_width="match_parent" android:layout_height="54dp" android:layout_gravity="bottom" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="16dp" android:background="@drawable/pickday_button_primary" android:clickable="true" android:focusable="true" android:gravity="center" android:includeFontPadding="false" android:text="@string/selection_next_text" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:minHeight="48dp" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/all_meetup_rooms_back_text" android:background="@drawable/pickday_card_white" android:textColor="#252538" android:textSize="22sp" android:padding="0dp" android:minWidth="0dp" android:minHeight="48dp" android:contentDescription="@string/action_back" android:layout_gravity="top|start" android:layout_marginStart="16dp" android:layout_marginTop="12dp" />
</FrameLayout>
