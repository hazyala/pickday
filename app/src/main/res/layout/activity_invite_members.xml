<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8F7FF">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="16dp" android:paddingEnd="16dp" android:paddingBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/all_meetup_rooms_back_text" android:background="@drawable/pickday_card_white" android:textColor="#252538" android:textSize="22sp" android:padding="0dp" android:minWidth="0dp" android:minHeight="48dp" android:contentDescription="@string/action_back" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/invite_members_label_text_2" android:textSize="24sp" android:textColor="#252538" android:includeFontPadding="true" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/invite_members_label_text_3" android:textSize="14sp" android:textColor="#252538" android:includeFontPadding="true" android:layout_marginTop="8dp" />
                    </LinearLayout>
                    <ImageView android:layout_width="96dp" android:layout_height="112dp" android:src="@drawable/invite_charactor" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/pickday_card_white" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="14dp" android:minHeight="100dp" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="0dp" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="vertical">
                        <TextView android:id="@+id/tvInviteRoomTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/invite_members_invite_room_title_text" android:textColor="#232336" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="0dp" android:background="@drawable/pickday_card_soft" android:gravity="center" android:includeFontPadding="false" android:paddingStart="9dp" android:paddingEnd="9dp" android:text="@string/invite_members_label_text_4" android:textColor="#6A4DFF" android:textSize="12sp" android:textStyle="bold" android:minHeight="24dp" android:layout_marginTop="8dp" android:padding="6dp" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvInviteDeadline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:includeFontPadding="false" android:text="@string/invite_members_invite_deadline_text" android:textColor="#77748E" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvInviteParticipants" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:includeFontPadding="false" android:text="@string/invite_members_invite_participants_text" android:textColor="#77748E" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/btnRoomInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/pickday_unselected" android:clickable="true" android:focusable="true" android:gravity="center" android:includeFontPadding="false" android:text="@string/invite_members_room_info_text" android:textColor="#6A4DFF" android:textSize="12sp" android:textStyle="bold" android:minHeight="48dp" android:layout_marginTop="12dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/pickday_card_white" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/invite_members_label_text_5" android:textColor="#232336" android:textSize="17sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/pickday_unselected" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp" android:minHeight="115dp">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/pickday_card_soft" android:padding="13dp" android:src="@drawable/icon_share" app:tint="#6A4DFF" android:scaleType="centerInside" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/invite_members_label_text_6" android:textColor="#232336" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:includeFontPadding="false" android:text="@string/invite_members_label_text_7" android:textColor="#716C87" android:textSize="12sp" android:textStyle="bold" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:minHeight="38dp">
                            <TextView android:id="@+id/tvInviteLink" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/pickday_unselected" android:gravity="center_vertical" android:includeFontPadding="false" android:paddingStart="10dp" android:singleLine="true" android:text="@string/invite_members_invite_room_title_text" android:textColor="#6A4DFF" android:textSize="12sp" android:textStyle="bold" />
                            <TextView android:id="@+id/btnCopy" android:layout_width="78dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:background="@drawable/pickday_button_primary" android:clickable="true" android:focusable="true" android:gravity="center" android:includeFontPadding="false" android:text="@string/invite_members_copy_text" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:minHeight="48dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/btnKakaoShare" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/pickday_unselected" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp" android:minHeight="75dp">
                    <TextView android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_kakao_icon" android:gravity="center" android:includeFontPadding="false" android:text="@string/invite_members_label_text_8" android:textColor="#3A2A00" android:textSize="12sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/invite_members_label_text_9" android:textColor="#232336" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:includeFontPadding="false" android:text="@string/invite_members_label_text_10" android:textColor="#716C87" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:layout_width="92dp" android:layout_height="wrap_content" android:background="@drawable/pickday_unselected" android:gravity="center" android:includeFontPadding="false" android:text="@string/invite_members_label_text_11" android:textColor="#6A4DFF" android:textSize="12sp" android:textStyle="bold" android:minHeight="38dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/pickday_card_white" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/invite_members_label_text_12" android:textColor="#232336" android:textSize="17sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="80dp">
                    <ImageView android:layout_width="68dp" android:layout_height="68dp" android:background="@drawable/pickday_card_soft" android:padding="18dp" android:src="@drawable/icon_group" app:tint="#6A4DFF" android:scaleType="centerInside" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/invite_members_label_text_13" android:textColor="#232336" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvInviteCurrentCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:includeFontPadding="false" android:text="@string/invite_members_invite_current_count_text" android:textColor="#6A4DFF" android:textSize="22sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvInviteCurrentSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:includeFontPadding="false" android:text="@string/invite_members_invite_current_summary_text" android:textColor="#716C87" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:layout_width="128dp" android:layout_height="wrap_content" android:background="@drawable/pickday_card_soft" android:gravity="center" android:includeFontPadding="false" android:text="@string/invite_members_label_text_14" android:textColor="#6A4DFF" android:textSize="12sp" android:textStyle="bold" android:minHeight="48dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/pickday_card_glass" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp" android:minHeight="66dp">
                    <ImageView android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/pickday_card_soft" android:padding="10dp" android:src="@drawable/icon_notification" app:tint="#6A4DFF" android:scaleType="centerInside" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/invite_members_label_text_15" android:textColor="#232336" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:includeFontPadding="false" android:text="@string/invite_members_label_text_16" android:textColor="#716C87" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchNotify" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>
                <TextView android:id="@+id/btnInviteDone" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:background="@drawable/pickday_button_primary" android:clickable="true" android:focusable="true" android:gravity="center" android:includeFontPadding="false" android:text="@string/invite_members_invite_done_text" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:minHeight="48dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
