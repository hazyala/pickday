<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="42dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/pickday_card_white"
            app:backgroundTint="@null"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="&lt;"
            android:textAllCaps="false"
            android:textColor="#202033"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/pickday_card_white"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvActionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="상세 화면"
                android:textColor="#202033"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActionSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3dp"
                android:text="설명"
                android:textColor="#77748E"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:background="#F0EEF8" />

            <TextView
                android:id="@+id/tvActionBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="5dp"
                android:text="본문"
                android:textColor="#202033"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4dp"
                android:text="현재 버전에서는 화면 이동과 기본 안내 정보를 먼저 제공합니다. 이후 서버 데이터가 연결되면 이 영역에 실제 목록과 설정 값을 표시합니다."
                android:textColor="#8A88A0"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
