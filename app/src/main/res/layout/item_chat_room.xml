<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/chatRoomRoot" android:layout_width="match_parent" android:layout_height="118dp" android:layout_marginBottom="14dp" android:background="@drawable/pickday_card_white" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="16dp">
    <TextView android:id="@+id/tvChatRoomIcon" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/pickday_card_soft" android:gravity="center" android:includeFontPadding="false" android:text="@string/room_badge_team" android:textColor="#5B4CDB" android:textSize="17sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvChatRoomTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:text="@string/invite_members_invite_room_title_text" android:textColor="#252538" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvChatRoomMessage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:text="@string/chat_room_chat_room_message_text" android:textColor="#77748E" android:textSize="13sp" />
        <TextView android:id="@+id/tvChatRoomInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:text="@string/chat_room_chat_room_info_text" android:textColor="#6A4DFF" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="42dp" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/chat_room_label_text" android:textColor="#716C87" android:textSize="12sp" />
        <TextView android:id="@+id/tvChatRoomRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:includeFontPadding="false" android:text="@string/invite_members_invite_room_title_text" android:textColor="#5B4CDB" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:includeFontPadding="false" android:text="@string/calendar_next_month_text" android:textColor="#9A98B2" android:textSize="24sp" />
    </LinearLayout>
</LinearLayout>
