<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chatRoomRoot"
    android:layout_width="match_parent"
    android:layout_height="118dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/pickday_card_white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/tvChatRoomIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/pickday_card_soft"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="팀"
        android:textColor="#5B4CDB"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvChatRoomTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="팀플 회의 일정"
            android:textColor="#252538"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChatRoomMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="약속 방에서 대화를 시작해보세요"
            android:textColor="#77748E"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvChatRoomInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="참여자 4명  |  마감까지 D-1"
            android:textColor="#6A4DFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="응답률"
            android:textColor="#8A88A0"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/tvChatRoomRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:text="100%"
            android:textColor="#5B4CDB"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:includeFontPadding="false"
            android:text="›"
            android:textColor="#9A98B2"
            android:textSize="24sp" />
    </LinearLayout>

</LinearLayout>
